{
  "id": "com.github.subtixx.factorio",
  "name": "Factorio",
  "description": "Enables managing Factorio mods and saves.",
  "author": "IT-Hock",
  "version": "1.0.0",
  "entry": "plugin.lua",
  "capabilities": {
    "filesystem": {
      "path_whitelist": [
        "$HOME/.factorio/*"
      ]
    },
    "network": {
      "url_whitelist": [
        "https://mods.factorio.com/*",
        "https://api.mod.io/*"
      ]
    }
  },
  "functionality": [
    "mod_management",
    "save_game_management"
  ],
  "settings": {
    "mod_directory": {
      "type": "string",
      "description": "The directory where Factorio mods are stored.",
      "default": null
    },
    "save_directory": {
      "type": "string",
      "description": "The directory where Factorio saves are stored.",
      "default": null
    }
  }
}